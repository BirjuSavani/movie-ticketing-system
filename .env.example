# Server Configuration
PORT=3000                           # Port the server listens on
NODE_ENV=development                # Environment: development | production | test

# PostgreSQL Database
DB_HOST=localhost                   # Database host
DB_PORT=5432                        # Database port
DB_USERNAME=postgres                # Database username
DB_PASSWORD=your_password_here      # Database password
DB_NAME=movie_ticketing             # Database name

# Test Database (used by Jest)
TEST_DB_NAME=movie_ticketing_test   # Separate test database name

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars_here    # Secret for signing access tokens
ACCESS_TOKEN_EXPIRES_IN=15m                                       # Access token expiry (15 minutes)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_here  # Secret for signing refresh tokens
REFRESH_TOKEN_EXPIRES_IN=7d                                       # Refresh token expiry (7 days)

# Bcrypt
BCRYPT_SALT_ROUNDS=12               # Number of bcrypt salt rounds

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000    # Auth rate limit window in ms (15 minutes)
RATE_LIMIT_AUTH_MAX=10              # Max auth requests per window
RATE_LIMIT_BOOKING_WINDOW_MS=60000  # Booking rate limit window in ms (1 minute)
RATE_LIMIT_BOOKING_MAX=20           # Max booking requests per window
RATE_LIMIT_GENERAL_WINDOW_MS=60000  # General rate limit window in ms (1 minute)
RATE_LIMIT_GENERAL_MAX=100          # Max general requests per window

# Seat Hold Duration
SEAT_HOLD_DURATION_MINUTES=10       # Minutes before a held seat expires
